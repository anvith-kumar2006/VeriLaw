# VeriLaw — Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git — it is already in .gitignore.

# ── Database ──────────────────────────────────────────────────────────
# Option A: full connection URL (takes priority)
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/verilaw

# Option B: individual MySQL settings (used if DATABASE_URL is blank)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=verilaw
DB_USER=root
DB_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────
# Required in production. Leave blank for dev (insecure default is used).
JWT_SECRET_KEY=

# ── Gemini AI ─────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/apikey
# Set EITHER GEMINI_API_KEY or GOOGLE_API_KEY — GEMINI_API_KEY takes priority.
GEMINI_API_KEY=

# ── Server ────────────────────────────────────────────────────────────
PORT=3000
FLASK_ENV=development
